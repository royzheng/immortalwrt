CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=128
# AIR6 flashes SquashFS; an uncompressed ext4 auxiliary root cannot fit this partition.
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_LIBCURL_CRYPTO_AUTH is not set
# CONFIG_LIBCURL_TFTP is not set
# CONFIG_LIBCURL_THREADED_RESOLVER is not set

# Tasks 0001-0008 and 0011; single-host Docker on the retained signed kernel.
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# fstools formats rootdisk overlay below 100 MiB as ext4.
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-proto-openvpn=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_luci-theme-material=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_ip-tiny is not set
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_OPENVPN_openssl_ENABLE_DCO is not set

# AIR6 uses cgroup v2. These v1/Swarm/Btrfs options change retained-kernel ABI.
# CONFIG_DOCKER_CGROUP_OPTIONS is not set
# CONFIG_DOCKER_OPTIONAL_FEATURES is not set
# CONFIG_DOCKER_NET_OVERLAY is not set
# CONFIG_DOCKER_NET_ENCRYPT is not set
# CONFIG_DOCKER_STO_BTRFS is not set
# CONFIG_PACKAGE_kmod-nf-ipvs is not set
# CONFIG_PACKAGE_btrfs-progs is not set
# CONFIG_PACKAGE_kmod-fs-btrfs is not set
# CONFIG_KERNEL_CGROUP_NET_PRIO is not set
# CONFIG_KERNEL_NET_CLS_CGROUP is not set
# CONFIG_KERNEL_CGROUP_NET_CLASSID is not set

# Preserve the signed kernel net_bridge layout; use ICC + userland proxy.
# CONFIG_PACKAGE_kmod-br-netfilter is not set
# CONFIG_PACKAGE_kmod-ipt-physdev is not set
