The MAP DPP enrollee extension accesses struct wpa_supplicant, which is
not available to standalone hostapd. Keep it for supplicant/multicall
builds and leave the AP-side MAP/WPS code enabled.

--- a/src/wps/wps_attr_build.c
+++ b/src/wps/wps_attr_build.c
@@ -16,7 +16,7 @@
 #include "crypto/random.h"
 #include "common/ieee802_11_defs.h"
 #include "wps_i.h"
-#ifdef CONFIG_MTK_MAP
+#if defined(CONFIG_MTK_MAP) && !defined(NO_SUPPLICANT)
 #include "wpa_supplicant_i.h"
 #endif /* CONFIG_MTK_MAP */
 
@@ -305,7 +305,7 @@
 	return 0;
 }
 
-#ifdef CONFIG_MTK_MAP
+#if defined(CONFIG_MTK_MAP) && !defined(NO_SUPPLICANT)
 int wps_build_dpp_uri(struct wps_data *wps, struct wpabuf *msg)
 {
 	struct wpa_supplicant *wpa = (struct wpa_supplicant *)wps->wps->cb_ctx;
