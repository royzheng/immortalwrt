config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	# Chassis LAN2 is device wan; chassis LAN1 (device lan) is the uplink.
	list ports 'wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '10.10.10.1/24'

config interface 'wan'
	option device 'lan'
	option proto 'dhcp'
	option metric '10'
	option dns_metric '10'

config interface 'wan6'
	option device '@wan'
	option proto 'dhcpv6'
	option metric '10'
	option dns_metric '10'

config interface 'modem5g'
	option proto 'ql_datacall'
	option iptype '3'
	option auto_conf '1'
	option metric '20'
	option dns_metric '20'
